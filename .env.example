# ================================================================
# Saqlabek Anti-Delete & View-Once Saver Bot - Sozlamalar fayli
# ================================================================

# Telegram Bot Token (@BotFather dan olingan)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# SQLite ma'lumotlar bazasi fayli yo'li
DB_PATH=saqlabek.db

# Vaqt zonasi (O'zbekiston uchun Asia/Tashkent)
TIMEZONE=Asia/Tashkent

# Akkaunt egasining o'zi yozib o'chirgan xabarlar haqida bildirishnoma:
# False = faqat suhbatdoshingiz o'chirgan xabarlar bot chatiga yuboriladi
# True  = o'zingiz o'chirgan xabarlar ham yuboriladi
NOTIFY_OWN_DELETED_MESSAGES=False

# Keshlangan xabarlarni saqlash muddati (kunlarda)
RETENTION_DAYS=30

# Eski xabarlarni tozalash oralig'i (soatlarda)
CLEANUP_INTERVAL_HOURS=24
